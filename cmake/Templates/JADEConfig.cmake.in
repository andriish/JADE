# JADEConfig.cmake: the installed JADE software (generated by the build of JADE, do not edit).
#
#   find_package(JADE REQUIRED)       # CMAKE_PREFIX_PATH: the install prefix, or JADE_DIR: this directory
#
# Imported targets: JADE::<name> for every installed executable and static library.
# Variables:
#   JADE_VERSION, JADE_PREFIX, JADE_BIN_DIR, JADE_LIB_DIR, JADE_DATA_DIR, JADE_CAL_DIR,
#   JADE_TEST_DIR (the test project with cards, programs and sample data: documentation and example of the use),
#   JADE_EXAMPLES_DIR (examples of analyses: a CMake project)
#   JADE_TOOLCHAIN, JADE_BITS, JADE_FORCE_32, JADE_BIG_ENDIAN (byte order of the host), JADE_TOOLCHAIN_ENV (NAME=VALUE list), JADE_PARTS
#   JADE_Fortran_COMPILER, JADE_C_COMPILER, JADE_CXX_COMPILER (and _ID, _VERSION)
#   JADE_OLD_MC, JADE_FPE, JADE_CAL_DIR_NAME (options of the build)
#   JADE_EXE_LINKER_FLAGS (the linker flags of the build: -m32, the libraries of the vendor compilers)
#   JADE_EXECUTABLES and JADE_LIBRARIES (names), JADE_<name>_EXECUTABLE and JADE_<name>_LIBRARY (full paths),
#   JADE_EXECUTABLE_PATHS (full paths of all executables)
#   JADE_H2ROOT (the installed jade_h2root), JADE_LUMI_DAT (lumi.dat), JADE_HELP_DATASET (F22BOW.HELP.DATASET):
#   full paths, empty if the file is not installed
#   JADE_LIBRARIES_STATIC (full paths of all libraries)
#   JADE_CERNLIB_LIBRARIES, JADE_MOTIF_LIBRARIES, JADE_X11_LIBRARIES, JADE_BLAS_LIBRARIES, JADE_LAPACK_LIBRARIES,
#   JADE_HEPMC3_LIBRARIES, JADE_ROOT_LIBRARIES: the external libraries that the parts were linked with,
#   JADE_EXTERNAL_LIBRARIES: all of them
# The variables of JADESOFTConfig.cmake (JADESOFT_*) are defined too.
# Macros and functions: jade_use_toolchain() (before project(): compilers, environment), jade_use_flags() (after
# project(): compiler and linker flags of the build), jade_link_group(<target> <libraries>...) (static libraries that
# refer to each other), jade_fortran_test(<test> <GNU env> <Intel env> <NAG env>) (environment of a test per Fortran
# compiler). After project(): the targets CERNLIB::packlib/kernlib/mathlib, LAPACK::LAPACK, BLAS::BLAS (found as
# dependencies) and the lists JADE_CORE_TARGETS and JADE_CERNLIB_TARGETS.
# With JADE_NO_TARGETS set only the variables and the macro are defined (usable before project()).

@PACKAGE_INIT@

set(JADE_VERSION @PROJECT_VERSION@)
set(JADE_VERSION_MAJOR @JADE_VERSION_MAJOR@)
set(JADE_VERSION_MINOR @JADE_VERSION_MINOR@)
set(JADE_VERSION_PATCH @JADE_VERSION_PATCH@)

set_and_check(JADE_PREFIX   "${PACKAGE_PREFIX_DIR}")
set_and_check(JADE_BIN_DIR  "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set_and_check(JADE_LIB_DIR  "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set_and_check(JADE_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/JADESOFT")
set_and_check(JADE_CAL_DIR  "@PACKAGE_CMAKE_INSTALL_DATADIR@/JADESOFT/cal")
set_and_check(JADE_TEST_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/JADE/test")
set_and_check(JADE_EXAMPLES_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/JADE/examples")

@JADE_CONFIG_INFO@

# the executables and libraries: those of the export file (JADETargets.cmake)
set(JADE_EXECUTABLES)
set(JADE_LIBRARIES)
set(JADE_LIBRARIES_STATIC)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/JADETargets.cmake" _jade_decl REGEX "^add_(executable|library)\\(JADE::[A-Za-z0-9_]+ ")
foreach(_d IN LISTS _jade_decl)
  if(_d MATCHES "^add_executable\\(JADE::([A-Za-z0-9_]+) ")
    list(APPEND JADE_EXECUTABLES ${CMAKE_MATCH_1})
    set(JADE_${CMAKE_MATCH_1}_EXECUTABLE "${JADE_BIN_DIR}/${CMAKE_MATCH_1}")
  elseif(_d MATCHES "^add_library\\(JADE::([A-Za-z0-9_]+) ")
    list(APPEND JADE_LIBRARIES ${CMAKE_MATCH_1})
    set(JADE_${CMAKE_MATCH_1}_LIBRARY "${JADE_LIB_DIR}/lib${CMAKE_MATCH_1}.a")
    list(APPEND JADE_LIBRARIES_STATIC "${JADE_${CMAKE_MATCH_1}_LIBRARY}")
  endif()
endforeach()
list(SORT JADE_EXECUTABLES)
list(SORT JADE_LIBRARIES)

set(JADE_EXECUTABLE_PATHS)
foreach(_e IN LISTS JADE_EXECUTABLES)
  list(APPEND JADE_EXECUTABLE_PATHS "${JADE_${_e}_EXECUTABLE}")
endforeach()

# the installation must be complete: every executable, jadez and jade_h2root, and the files of the parts that were built.
# Otherwise the
# package counts as not found (find_package(JADE REQUIRED) stops with the message).
set(_jade_missing)
foreach(_e IN LISTS JADE_EXECUTABLES)
  if(NOT EXISTS "${JADE_${_e}_EXECUTABLE}")
    list(APPEND _jade_missing "${JADE_${_e}_EXECUTABLE}")
  endif()
endforeach()
set(_jade_files "${JADE_DATA_DIR}/F22BOW.HELP.DATASET")
if("jtuple" IN_LIST JADE_PARTS)
  list(APPEND _jade_files "${JADE_DATA_DIR}/lumi.dat")
endif()
foreach(_f IN LISTS _jade_files)
  if(NOT EXISTS "${_f}")
    list(APPEND _jade_missing "${_f}")
  endif()
endforeach()
# jadez and jade_h2root (the h2root of ROOT 6.40 crashes on 64 bit machines) are always required
set(_jade_required_exe jadez jade_h2root)
if("jtuple" IN_LIST JADE_PARTS)
  list(APPEND _jade_required_exe taklumi)
endif()
foreach(_p IN LISTS _jade_required_exe)
  if(NOT _p IN_LIST JADE_EXECUTABLES)
    list(APPEND _jade_missing "executable ${_p}")
  endif()
endforeach()
if(_jade_missing)
  string(REPLACE ";" "\n  " _jade_missing_text "${_jade_missing}")
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "The JADE installation in ${JADE_PREFIX} is incomplete, missing:\n  ${_jade_missing_text}")
  return()
endif()

# programs and data files of the installation that are looked up often (empty if not installed)
set(JADE_H2ROOT "")
if(EXISTS "${JADE_BIN_DIR}/jade_h2root")
  set(JADE_H2ROOT "${JADE_BIN_DIR}/jade_h2root")
endif()
set(JADE_LUMI_DAT "")
if(EXISTS "${JADE_DATA_DIR}/lumi.dat")
  set(JADE_LUMI_DAT "${JADE_DATA_DIR}/lumi.dat")
endif()
set(JADE_HELP_DATASET "")
if(EXISTS "${JADE_DATA_DIR}/F22BOW.HELP.DATASET")
  set(JADE_HELP_DATASET "${JADE_DATA_DIR}/F22BOW.HELP.DATASET")
endif()

# jade_fortran_test(<test> <GNU environment> <Intel environment> <NAG environment>): sets the environment of a
# test according to the Fortran compiler (the variables of the Fortran runtime that select the byte order of the
# data files); the NVIDIA runtime uses FORT_CONVERT_UNIT with the same syntax as GFORTRAN_CONVERT_UNIT.
# The lists with semicolons are passed as in "GFORTRAN_CONVERT_UNIT=big_endian\;native:2".
macro( jade_fortran_test testname gnuenv  intelenv nagenv)
  if (${CMAKE_Fortran_COMPILER_ID}  MATCHES  "GNU")
     set_property( TEST ${testname} PROPERTY ENVIRONMENT "${gnuenv}")
  endif()
  if (${CMAKE_Fortran_COMPILER_ID}  MATCHES  "Intel")
     set_property( TEST ${testname} PROPERTY ENVIRONMENT "${intelenv}")
  endif()
  if (${CMAKE_Fortran_COMPILER_ID}  MATCHES  "NAG")
     set_property( TEST ${testname} PROPERTY ENVIRONMENT "${nagenv}")
  endif()
  if (${CMAKE_Fortran_COMPILER_ID}  MATCHES  "PGI|NVHPC")
     string(REPLACE "GFORTRAN_CONVERT_UNIT" "FORT_CONVERT_UNIT" nvenv "${gnuenv}")
     set_property( TEST ${testname} PROPERTY ENVIRONMENT "${nvenv}")
  endif()
endmacro( jade_fortran_test )

# jade_use_toolchain(): call it before project(): the compilers of the installation (unless given), the environment of
# the toolchain (setvars.sh of oneAPI, PATH of the vendor compilers, ...) for the configuration, and for the compilation
# and linking through the launchers.
macro(jade_use_toolchain)
  foreach(_jade_l Fortran C CXX)
    if(JADE_${_jade_l}_COMPILER AND NOT CMAKE_${_jade_l}_COMPILER)
      set(CMAKE_${_jade_l}_COMPILER "${JADE_${_jade_l}_COMPILER}")
    endif()
  endforeach()
  foreach(_jade_e ${JADE_TOOLCHAIN_ENV})
    if(_jade_e MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
      set(ENV{${CMAKE_MATCH_1}} "${CMAKE_MATCH_2}")
    endif()
  endforeach()
  if(JADE_TOOLCHAIN_ENV)
    foreach(_jade_l Fortran C CXX)
      set(CMAKE_${_jade_l}_COMPILER_LAUNCHER ${CMAKE_COMMAND} -E env ${JADE_TOOLCHAIN_ENV})
      set(CMAKE_${_jade_l}_LINKER_LAUNCHER   ${CMAKE_COMMAND} -E env ${JADE_TOOLCHAIN_ENV})
    endforeach()
  endif()
endmacro()

# jade_use_flags(): call it after project(): the compiler flags (Fortran, C, C++) and the linker flags of the build of
# the installation (-m32, the options for the old Fortran code), and the settings of a 32 bit build.
macro(jade_use_flags)
  set(CMAKE_Fortran_FLAGS "${JADE_Fortran_FLAGS}")
  set(CMAKE_C_FLAGS "${JADE_C_FLAGS}")
  set(CMAKE_CXX_FLAGS "${JADE_CXX_FLAGS}")
  set(CMAKE_EXE_LINKER_FLAGS "${JADE_EXE_LINKER_FLAGS}")
  if(JADE_FORCE_32)
    list(PREPEND CMAKE_SYSTEM_LIBRARY_PATH "/usr/lib")
    set(FIND_LIBRARY_USE_LIB32_PATHS ON)
    set(FIND_LIBRARY_USE_LIB64_PATHS OFF)
    set(CMAKE_SIZEOF_VOID_P 4)
    if("${LIB_SUFFIX}" STREQUAL "64")
      set(LIB_SUFFIX)
    endif()
  endif()
endmacro()

# jade_link_group(<target> <libraries>...): links static libraries that refer to each other (the JADE libraries, CERNLIB,
# which calls back) as a group that the linker scans repeatedly (not on macOS, whose linker needs no group).
function(jade_link_group target)
  if(APPLE)
    target_link_libraries(${target} PRIVATE ${ARGN})
  else()
    list(JOIN ARGN "," _jade_group)
    target_link_libraries(${target} PRIVATE "$<LINK_GROUP:RESCAN,${_jade_group}>")
  endif()
endfunction()

if(NOT JADE_NO_TARGETS AND NOT CMAKE_SCRIPT_MODE_FILE)
  include("${CMAKE_CURRENT_LIST_DIR}/JADETargets.cmake")
  if(EXISTS "${JADE_DATA_DIR}/cmake/JADESOFTConfig.cmake")
    include("${JADE_DATA_DIR}/cmake/JADESOFTConfig.cmake")
  endif()
  # what the programs that use the libraries link besides them: CERNLIB (which has only variables: imported targets
  # are made from them), LAPACK and BLAS. JADE_CORE_TARGETS and JADE_CERNLIB_TARGETS are the lists of targets,
  # to be used as: jade_link_group(<target> ${JADE_CORE_TARGETS} ${JADE_CERNLIB_TARGETS}) and target_link_libraries(<target> PRIVATE LAPACK::LAPACK BLAS::BLAS)
  include(CMakeFindDependencyMacro)
  find_dependency(CERNLIB)
  find_dependency(LAPACK)
  find_dependency(BLAS)
  foreach(_jade_l packlib kernlib mathlib)
    string(TOUPPER ${_jade_l} _jade_lu)
    if(NOT TARGET CERNLIB::${_jade_l})
      add_library(CERNLIB::${_jade_l} STATIC IMPORTED)
      set_target_properties(CERNLIB::${_jade_l} PROPERTIES IMPORTED_LOCATION "${CERNLIB_${_jade_lu}_STATIC}"
                            IMPORTED_LINK_INTERFACE_LANGUAGES Fortran)
    endif()
  endforeach()
  set(JADE_CORE_TARGETS JADE::interface JADE::jadegs JADE::boslib JADE::zlib)
  set(JADE_CERNLIB_TARGETS CERNLIB::packlib CERNLIB::kernlib CERNLIB::mathlib)
endif()
set(JADE_FOUND TRUE)
