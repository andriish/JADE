# Selection of the compilers and of the build environment from a toolchain name and the number
# of bits: the CMake version of the toolchain part of jadeinstall.sh / jadetest.sh.
#
# Input variables (cache or normal):
#   JADE_TOOLCHAIN   GNU (default), GNU-11 ... GNU-16 (macOS: Homebrew gcc-NN), Intel, XL, NAG, PGI (NVIDIA HPC SDK), SUN
#   JADE_BITS        32 or 64 (default: 32 on an i686 host, 64 otherwise)
#
# Output variables:
#   JADE_TOOLCHAIN, JADE_BITS      checked values
#   JADE_CC, JADE_CXX, JADE_FC     names of the C, C++ and Fortran compilers
#   JADE_TOOLCHAIN_ENV             list NAME=VALUE of the environment the compilers need
#                                  (use it as ${CMAKE_COMMAND} -E env ${JADE_TOOLCHAIN_ENV} <command>)
#   JADE_FORCE_32                  ON for JADE_BITS=32
#
# The module does not need a language to be enabled: it can be included before project().

set(JADE_TOOLCHAINS GNU GNU-11 GNU-12 GNU-13 GNU-14 GNU-15 GNU-16 Intel XL NAG PGI SUN)
if(NOT JADE_TOOLCHAIN)
  set(JADE_TOOLCHAIN GNU)
endif()
if(NOT JADE_TOOLCHAIN IN_LIST JADE_TOOLCHAINS)
  message(WARNING "Unknown toolchain ${JADE_TOOLCHAIN}, using GNU instead. Possible values: ${JADE_TOOLCHAINS}")
  set(JADE_TOOLCHAIN GNU)
endif()
message(STATUS "JADE toolchain: ${JADE_TOOLCHAIN}")

# bits
if(CMAKE_HOST_APPLE)
  set(_jade_bits 64)
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(i686|i386)$")
  set(_jade_bits 32)
else()
  set(_jade_bits 64)
endif()
if(NOT JADE_BITS)
  set(JADE_BITS ${_jade_bits})
endif()
if(NOT JADE_BITS MATCHES "^(32|64)$")
  message(WARNING "Unknown bits ${JADE_BITS}, using 64 instead. Possible values: 32, 64")
  set(JADE_BITS 64)
endif()
# 32 bit builds (-m32) are only possible on x86
if(JADE_BITS EQUAL 32 AND NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|i686|i386)$")
  message(FATAL_ERROR "32 bit builds are not supported on ${CMAKE_HOST_SYSTEM_PROCESSOR}, use -DJADE_BITS=64")
endif()
# a cache variable: the parts declare option(JADE_FORCE_32) themselves
if(JADE_BITS EQUAL 32)
  set(JADE_FORCE_32 ON CACHE BOOL "Force build of 32 bit libraries." FORCE)
else()
  set(JADE_FORCE_32 OFF CACHE BOOL "Force build of 32 bit libraries." FORCE)
endif()

# environment: the changes with respect to the current one, as a list NAME=VALUE
set(JADE_TOOLCHAIN_ENV "")
macro(_jade_env name value)
  set(ENV{${name}} "${value}")
  list(APPEND JADE_TOOLCHAIN_ENV "${name}=${value}")
endmacro()

if(CMAKE_HOST_APPLE)
  _jade_env(PATH "/usr/local/bin:$ENV{PATH}")
  # Target the running macOS (e.g. 27.0), like the Homebrew libraries: a lower target gives one
  # "built for newer 'macOS' version" linker warning per object file. Set the variable to override.
  if(DEFINED ENV{MACOSX_DEPLOYMENT_TARGET})
    set(_jade_osx "$ENV{MACOSX_DEPLOYMENT_TARGET}")
  else()
    execute_process(COMMAND sw_vers -productVersion OUTPUT_VARIABLE _jade_osx_full OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX REPLACE "\\..*$" ".0" _jade_osx "${_jade_osx_full}")
  endif()
  _jade_env(MACOSX_DEPLOYMENT_TARGET "${_jade_osx}")
endif()

# oneAPI: the environment is the one that setvars.sh sets
macro(_jade_source_env script)
  if(NOT EXISTS ${script})
    message(FATAL_ERROR "${script} not found: install the Intel oneAPI compilers")
  endif()
  execute_process(COMMAND bash -c ". ${script} --force >/dev/null 2>&1; env -0"
                  OUTPUT_VARIABLE _jade_envout RESULT_VARIABLE _jade_envrc)
  if(NOT _jade_envrc EQUAL 0)
    message(FATAL_ERROR "cannot source ${script}")
  endif()
  string(REPLACE "\;" "<sc>" _jade_envout "${_jade_envout}")
  string(ASCII 0 _jade_nul)
  string(REPLACE "${_jade_nul}" "\;" _jade_envout "${_jade_envout}")
  foreach(_jade_line IN LISTS _jade_envout)
    string(REPLACE "<sc>" "\;" _jade_line "${_jade_line}")
    if(_jade_line MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
      set(_n ${CMAKE_MATCH_1})
      set(_v "${CMAKE_MATCH_2}")
      if(NOT _n MATCHES "^(_|SHLVL|PWD|OLDPWD)$" AND NOT "$ENV{${_n}}" STREQUAL "${_v}")
        _jade_env(${_n} "${_v}")
      endif()
    endif()
  endforeach()
endmacro()

if(JADE_TOOLCHAIN STREQUAL "GNU")
  if(CMAKE_HOST_APPLE)
    # as in jadeinstall.sh: the plain GNU toolchain does not set the compilers on macOS (use GNU-NN),
    # CMake finds its default ones
    set(JADE_CC "")
    set(JADE_CXX "")
    set(JADE_FC "")
  else()
    set(JADE_CC gcc)
    set(JADE_CXX g++)
    set(JADE_FC gfortran)
  endif()
elseif(JADE_TOOLCHAIN MATCHES "^GNU-([0-9]+)$")
  if(NOT CMAKE_HOST_APPLE)
    message(FATAL_ERROR "The toolchain ${JADE_TOOLCHAIN} (Homebrew gcc-NN) is for macOS, use GNU")
  endif()
  set(JADE_CC gcc-${CMAKE_MATCH_1})
  set(JADE_CXX clang++)
  set(JADE_FC gfortran-${CMAKE_MATCH_1})
elseif(JADE_TOOLCHAIN STREQUAL "Intel")
  _jade_source_env(/opt/intel/oneapi/setvars.sh)
  set(JADE_CC icx)
  set(JADE_CXX icpx)
  set(JADE_FC ifx)
  find_program(_jade_ifx ifx)
  find_program(_jade_icx icx)
  find_program(_jade_icpx icpx)
  if(NOT _jade_ifx OR NOT _jade_icx OR NOT _jade_icpx)
    message(FATAL_ERROR "Intel compilers (ifx, icx, icpx) not found after setvars.sh; install intel-oneapi-compiler-fortran and intel-oneapi-compiler-dpcpp-cpp")
  endif()
elseif(JADE_TOOLCHAIN STREQUAL "XL")
  set(JADE_CC xlc)
  set(JADE_CXX xlC)
  set(JADE_FC xlf)
elseif(JADE_TOOLCHAIN STREQUAL "NAG")
  _jade_env(NAG_KUSARI_FILE /opt/NAG/licence.lic)
  _jade_env(PATH "/opt/NAG/bin:$ENV{PATH}")
  _jade_env(LD_LIBRARY_PATH "/opt/NAG/lib/NAG_Fortran:$ENV{LD_LIBRARY_PATH}")
  set(JADE_CC gcc)
  set(JADE_CXX g++)
  set(JADE_FC nagfor)
elseif(JADE_TOOLCHAIN STREQUAL "PGI")
  # NVIDIA HPC SDK: the newest installed version
  file(GLOB _jade_nvhpc LIST_DIRECTORIES true "/opt/nvidia/hpc_sdk/Linux_x86_64/[0-9]*.[0-9]*/compilers/bin")
  list(SORT _jade_nvhpc COMPARE NATURAL)
  list(REVERSE _jade_nvhpc)
  list(GET _jade_nvhpc 0 _jade_nvhpc_bin)
  if(NOT _jade_nvhpc_bin OR NOT EXISTS "${_jade_nvhpc_bin}/nvfortran")
    message(FATAL_ERROR "nvfortran not found in /opt/nvidia/hpc_sdk/Linux_x86_64/*/compilers/bin")
  endif()
  _jade_env(PATH "${_jade_nvhpc_bin}:$ENV{PATH}")
  set(JADE_CC nvc)
  set(JADE_CXX nvc++)
  set(JADE_FC nvfortran)
elseif(JADE_TOOLCHAIN STREQUAL "SUN")
  _jade_env(PATH "/opt/oracle/developerstudio12.6/bin:$ENV{PATH}")
  _jade_env(LD_LIBRARY_PATH "/opt/oracle/developerstudio12.6/lib:$ENV{LD_LIBRARY_PATH}")
  set(JADE_CC suncc)
  set(JADE_CXX sunCC)
  set(JADE_FC sunf77)
endif()
# the -D arguments that select the compilers (nothing for the default ones)
set(JADE_COMPILER_ARGS "")
if(JADE_CC)
  list(APPEND JADE_COMPILER_ARGS -DCMAKE_C_COMPILER=${JADE_CC})
endif()
if(JADE_CXX)
  list(APPEND JADE_COMPILER_ARGS -DCMAKE_CXX_COMPILER=${JADE_CXX})
endif()
if(JADE_FC)
  list(APPEND JADE_COMPILER_ARGS -DCMAKE_Fortran_COMPILER=${JADE_FC})
endif()
message(STATUS "JADE compilers: C=${JADE_CC} C++=${JADE_CXX} Fortran=${JADE_FC}, ${JADE_BITS} bit")
