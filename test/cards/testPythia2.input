#
# Process: ee -> gamma*/Z -> hadrons @ 43.8 GeV
#
Main:numberOfEvents = 2000

WeakSingleBoson:ffbar2gmZ = on

Beams:idA =  11
Beams:idB = -11
Beams:eCM =  43.8

# Photon radiation: ISR from the beam electrons (photon emission off the leptons)
# and FSR from the quarks; the QCD parton shower stays off
HadronLevel:all = on
HadronLevel:Hadronize = on
PDF:lepton = on
PartonLevel:ISR = on
PartonLevel:FSR = on
SpaceShower:QEDshowerByL = on
TimeShower:QEDshowerByQ = on
TimeShower:QEDshowerByL = off
TimeShower:QCDshower = off

# Set Z properties
23:onMode = off
23:onIfAny = 1,2,3,4,5

# Let the tau decay (the decays were very slow in Pythia 8.185, not any more)
15:mayDecay  = on
-15:mayDecay = on

